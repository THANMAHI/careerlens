# Server Configuration
PORT=5000

# Optional MongoDB Connection String (System will default to in-memory session storage if omitted or offline)
MONGODB_URI=mongodb://localhost:27017/careerlens

# AI LLM Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Course & Video Recommendations Configuration (Optional - Curated fallback dataset will be used if omitted)
YOUTUBE_API_KEY=your_youtube_api_key_here
COURSE_API_KEY=your_course_api_key_here
COURSE_API_URL=https://api.example.com/courses
